    "groups": [
      {
        "start": 0.06666666666666667,
        "end": 0.7,
        "text": "Before you pay for an"
      },
      {
        "start": 0.7333333333333334,
        "end": 1.9333333333333333,
        "text": "AI course, check these three"
      },
      {
        "start": 1.9666666666666666,
        "end": 2.3833333333333337,
        "text": "things."
      },
      {
        "start": 2.466666666666667,
        "end": 3.5999999999999996,
        "text": "First, the project."
      },
      {
        "start": 3.8,
        "end": 4.983333333333333,
        "text": "Will you build something yourself"
      },
      {
        "start": 5.016666666666667,
        "end": 6,
        "text": "or just follow a demo?"
      },
      {
        "start": 6.25,
        "end": 7.45,
        "text": "Ask to see a finished"
      },
      {
        "start": 7.516666666666667,
        "end": 8.283333333333333,
        "text": "student project."
      },
      {
        "start": 8.683333333333334,
        "end": 9.733333333333334,
        "text": "Second, the feedback."
      },
      {
        "start": 9.966666666666669,
        "end": 10.966666666666667,
        "text": "Who reviews your work and"
      },
      {
        "start": 11,
        "end": 11.55,
        "text": "how often?"
      },
      {
        "start": 11.816666666666666,
        "end": 12.883333333333335,
        "text": "Check what support is actually"
      },
      {
        "start": 12.916666666666668,
        "end": 13.400000000000002,
        "text": "included."
      },
      {
        "start": 13.649166666666668,
        "end": 15.133333333333335,
        "text": "Third, the career promise."
      },
      {
        "start": 15.516666666666667,
        "end": 16.51666666666667,
        "text": "If a placement number is"
      },
      {
        "start": 16.55,
        "end": 18.066666666666666,
        "text": "advertised, ask who it counts"
      },
      {
        "start": 18.1,
        "end": 19.01666666666667,
        "text": "and over what period."
      },
      {
        "start": 19.3,
        "end": 20.283333333333335,
        "text": "A certificate is one part"
      },
      {
        "start": 20.316666666666666,
        "end": 21.21666666666667,
        "text": "of the decision, not the"
      },
      {
        "start": 21.25,
        "end": 21.833333333333332,
        "text": "whole picture."
      },
      {
        "start": 22.25,
        "end": 23.81666666666667,
        "text": "Compare the syllabus, feedback, and"
      },
      {
        "start": 23.85,
        "end": 25.133333333333333,
        "text": "total cost before you enroll."
      },
      {
        "start": 25.333333333333332,
        "end": 26.366666666666667,
        "text": "Save this checklist for your"
      },
      {
        "start": 26.400000000000002,
        "end": 27.365833333333335,
        "text": "next course comparison."
      }
