{%- liquid
  assign items = section.settings.messages | newline_to_br | split: '<br />'
-%}
{%- if section.settings.messages != blank -%}
  <div class="announcement on-dark" role="region" aria-label="Offres en cours">
    <div class="wrap announcement__inner">
      {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
      <ul class="announcement__list" data-rotator>
        {%- assign shown = 0 -%}
        {%- for item in items -%}
          {%- assign msg = item | strip -%}
          {%- if msg != blank -%}
            <li{% if shown > 0 %} aria-hidden="true"{% endif %}>{{ msg }}</li>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if section.settings.link != blank -%}</a>{%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau d’offres",
  "class": "announcement-section",
  "settings": [
    {
      "type": "textarea",
      "id": "messages",
      "label": "Messages (un par ligne)",
      "default": "<strong>2 ebooks achetés, le 3ᵉ offert</strong>, sans code\nPack de 4 ebooks à 49,90 € au lieu de 79,60 €\nTéléchargement immédiat après le paiement",
      "info": "Les messages s’affichent l’un après l’autre. Le gras s’écrit <strong>texte</strong>. N’annoncez que des offres réelles et en cours."
    },
    { "type": "url", "id": "link", "label": "Lien (facultatif)" }
  ],
  "presets": [{ "name": "Bandeau d’offres" }]
}
{% endschema %}
