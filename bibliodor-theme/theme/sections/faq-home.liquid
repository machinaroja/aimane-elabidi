<section class="section faq-home" aria-labelledby="faq-{{ section.id }}">
  <div class="wrap faq-home__grid">
    <header class="section-head">
      <h2 id="faq-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte page-intro">{{ section.settings.text }}</div>{%- endif -%}
    </header>
    <div class="faq-list">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ (accueil)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Avant d’acheter" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Une autre question ? <a href=\"/pages/contact\">Écris-nous</a>, on répond à chaque message.</p>" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Réponse" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ (accueil)" }]
}
{% endschema %}
