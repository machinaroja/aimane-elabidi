{%- assign shelf = section.settings.collection.products | default: collections.all.products -%}
<section class="hero" aria-labelledby="hero-{{ section.id }}">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <h1 id="hero-{{ section.id }}">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="hero__lead">{{ section.settings.text }}</p>{%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a class="btn btn-gold" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="btn btn-ghost" href="{{ section.settings.secondary_link | default: '#nouveautes' }}">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
      <ul class="hero__proof" aria-label="Nos engagements">
        <li><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14"/></svg>Téléchargement immédiat</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 11V8a5 5 0 0 1 10 0v3"/><rect x="5" y="11" width="14" height="10" rx="2"/></svg>Paiement sécurisé</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/></svg>PDF lisible sur tous tes écrans</li>
      </ul>
    </div>

    {%- if shelf.size > 0 -%}
      <div class="lectern">
        <ul class="lectern__books">
          {%- for product in shelf limit: 3 -%}
            <li>
              <a href="{{ product.url }}">
                {% render 'book-cover', product: product, loading: 'eager', sizes: '(min-width: 60rem) 16vw, 32vw' %}
                <span class="visually-hidden">{{ product.title }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
        <div class="lectern__caption">
          <p>{{ section.settings.shelf_caption }}</p>
          {%- if section.settings.collection != blank -%}
            <a class="text-link" href="{{ section.settings.collection.url }}">{{ section.settings.shelf_link_label }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ouverture et étagère",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Des livres pour comprendre comment on pense, on gagne et on décide." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "BIBLIODOR édite des ebooks en français sur la psychologie, l’argent, le pouvoir et l’influence. Des textes clairs, structurés et utiles, à lire sur tous tes écrans." },
    { "type": "collection", "id": "collection", "label": "Livres posés sur le plateau", "info": "Les trois premiers livres de la collection." },
    { "type": "text", "id": "shelf_caption", "label": "Légende du plateau", "default": "Les dernières parutions" },
    { "type": "text", "id": "shelf_link_label", "label": "Lien du plateau", "default": "Voir les nouveautés" },
    { "type": "text", "id": "primary_label", "label": "Bouton principal", "default": "Parcourir le catalogue" },
    { "type": "url", "id": "primary_link", "label": "Lien du bouton principal" },
    { "type": "text", "id": "secondary_label", "label": "Bouton secondaire", "default": "Voir les nouveautés" },
    { "type": "text", "id": "secondary_link", "label": "Lien du bouton secondaire", "default": "#nouveautes" }
  ],
  "presets": [{ "name": "Ouverture et étagère" }]
}
{% endschema %}
