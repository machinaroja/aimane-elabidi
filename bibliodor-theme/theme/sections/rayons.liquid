<section class="section wrap" aria-labelledby="rayons-{{ section.id }}">
  <header class="section-head">
    <h2 id="rayons-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
  </header>
  <ol class="toc">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      {%- if c != blank -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ c.url }}" class="toc__row">
            {% render 'emblem', name: block.settings.emblem, class: 'toc__emblem' %}
            <span class="toc__main">
              <span class="toc__name">{{ c.title }}</span>
              {%- assign summary = block.settings.summary | default: c.description | strip_html | truncatewords: 20 -%}
              {%- if summary != blank -%}<span class="toc__summary">{{ summary }}</span>{%- endif -%}
            </span>
            <span class="toc__leader" aria-hidden="true"></span>
            <span class="toc__count">{% if c.products_count > 0 %}{{ 'collections.count' | t: count: c.products_count }}{% else %}{{ 'collections.soon' | t }}{% endif %}</span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ol>
</section>

{% schema %}
{
  "name": "Rayons (sommaire)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Les rayons" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Quatre domaines, choisis parce qu’ils changent concrètement la vie de ceux qui s’y intéressent." }
  ],
  "blocks": [
    {
      "type": "rayon",
      "name": "Rayon",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "textarea", "id": "summary", "label": "Résumé", "info": "Sinon, la description de la collection est utilisée." },
        {
          "type": "select",
          "id": "emblem",
          "label": "Emblème",
          "options": [
            { "value": "rings", "label": "Cercles (psychologie)" },
            { "value": "steps", "label": "Escalier (développement personnel)" },
            { "value": "coin", "label": "Pièces (argent)" },
            { "value": "column", "label": "Colonnade (pouvoir et influence)" }
          ],
          "default": "rings"
        }
      ]
    }
  ],
  "presets": [{ "name": "Rayons (sommaire)" }]
}
{% endschema %}
