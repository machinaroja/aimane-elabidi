{%- comment -%}
  Offre « Trilogie IA » sous le bouton d'achat des fiches N°06, N°07 et N°08.
  Elle s'appuie sur la remise automatique « 2 ebooks achetés, le 3e offert » (aucune autre remise).
  Seuls les titres en ligne et disponibles sont proposés ; sans au moins un autre titre, rien ne s'affiche.
  Paramètre : product
{%- endcomment -%}
{%- liquid
  assign handles = 'l-intelligence-artificielle-de-a-a-z,gagner-de-l-argent-avec-l-ia,les-200-prompts-essentiels' | split: ','
  assign others = 0
  for h in handles
    if h != product.handle
      assign p = all_products[h]
      if p and p.available
        assign others = others | plus: 1
      endif
    endif
  endfor
-%}
{%- if others > 0 -%}
<form class="trilogy" action="{{ routes.cart_add_url }}" method="post" data-trilogy aria-labelledby="trilogy-title">
  <div class="trilogy__head">
    <p id="trilogy-title">Complète la trilogie IA</p>
    <span class="trilogy__badge">🎁 3ᵉ offert</span>
  </div>
  <ul class="trilogy__list">
    {%- assign i = 0 -%}
    {%- for h in handles -%}
      {%- if h == product.handle -%}{%- assign p = product -%}{%- else -%}{%- assign p = all_products[h] -%}{%- endif -%}
      {%- if p and p.available -%}
        {%- assign v = p.selected_or_first_available_variant -%}
        <li class="trilogy__item" data-trilogy-item data-variant="{{ v.id }}" data-price="{{ v.price }}">
          <label>
            <input type="checkbox" name="items[{{ i }}][id]" value="{{ v.id }}" checked{% if p.id == product.id %} data-current{% endif %}>
            {%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 120 }}" alt="" width="48" height="68" loading="lazy">{%- else -%}<span></span>{%- endif -%}
            <span class="trilogy__name">{{ p.title | split: ' — ' | last }}<small>{% if p.id == product.id %}Ce guide{% else %}{{ p.title | split: ' — ' | first }}{% endif %}<span data-in-cart hidden> · déjà dans ton panier</span></small></span>
            <span class="trilogy__price">{{ v.price | money }}</span>
          </label>
          <input type="hidden" name="items[{{ i }}][quantity]" value="1">
        </li>
        {%- assign i = i | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </ul>
  <div class="trilogy__foot">
    <p class="trilogy__msg" data-trilogy-msg aria-live="polite">Les 3 guides : le moins cher est offert automatiquement, sans code.</p>
    <button type="submit" class="btn btn-primary trilogy__btn" data-trilogy-btn>Ajouter au panier</button>
  </div>
</form>
<script>
(() => {
  const form = document.querySelector('[data-trilogy]');
  if (!form || form.dataset.ready) return;
  form.dataset.ready = '1';
  const items = [...form.querySelectorAll('[data-trilogy-item]')];
  const msg = form.querySelector('[data-trilogy-msg]');
  const btn = form.querySelector('[data-trilogy-btn]');
  const fmt = (c) => new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(c / 100);
  let inCart = new Set();

  const update = () => {
    const chosen = items.filter((li) => li.querySelector('input[type=checkbox]').checked || inCart.has(li.dataset.variant));
    const toAdd = chosen.filter((li) => !inCart.has(li.dataset.variant));
    const prices = chosen.map((li) => +li.dataset.price);
    const full = prices.reduce((a, b) => a + b, 0);
    const free = prices.length >= 3 ? Math.min(...prices) : 0;
    if (prices.length >= 3) {
      msg.innerHTML = `<strong>Les 3 guides : ${fmt(full - free)}</strong> <s>${fmt(full)}</s> · le 3ᵉ est offert`;
    } else if (prices.length === 2) {
      msg.innerHTML = `Coche le 3ᵉ guide : <strong>il est offert</strong>.`;
    } else {
      msg.textContent = 'Ajoute 2 autres guides : le moins cher est offert automatiquement.';
    }
    btn.disabled = toAdd.length === 0;
    btn.textContent = toAdd.length === 0 ? 'Déjà dans ton panier'
      : prices.length >= 3 ? `Ajouter la trilogie · ${fmt(full - free)}`
      : `Ajouter ${toAdd.length > 1 ? 'les ' + toAdd.length + ' guides' : 'au panier'}`;
  };

  items.forEach((li) => li.querySelector('input[type=checkbox]').addEventListener('change', update));

  fetch('/cart.js').then((r) => r.json()).then((cart) => {
    inCart = new Set(cart.items.map((it) => String(it.variant_id)));
    items.forEach((li) => {
      if (inCart.has(li.dataset.variant)) {
        li.classList.add('is-in-cart');
        const cb = li.querySelector('input[type=checkbox]');
        cb.checked = true; cb.disabled = true;
        li.querySelector('[data-in-cart]').hidden = false;
      }
    });
    update();
  }).catch(update);
  update();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const add = items.filter((li) => li.querySelector('input[type=checkbox]').checked && !inCart.has(li.dataset.variant))
      .map((li) => ({ id: +li.dataset.variant, quantity: 1 }));
    if (!add.length) return;
    btn.disabled = true; btn.textContent = 'Ajout en cours…';
    try {
      const r = await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: add }) });
      if (!r.ok) throw new Error();
      if (window.BIBLIODOR_OPEN_CART) {
        const cart = await fetch('/cart.js').then((res) => res.json());
        document.querySelectorAll('[data-cart-count]').forEach((el) => { el.textContent = cart.item_count; el.hidden = cart.item_count === 0; });
        inCart = new Set(cart.items.map((it) => String(it.variant_id)));
        items.forEach((li) => {
          if (!inCart.has(li.dataset.variant)) return;
          li.classList.add('is-in-cart');
          const cb = li.querySelector('input[type=checkbox]');
          cb.checked = true; cb.disabled = true;
          li.querySelector('[data-in-cart]').hidden = false;
        });
        update();
        window.BIBLIODOR_OPEN_CART(cart);
      } else {
        window.location.href = '{{ routes.cart_url }}';
      }
    } catch (err) {
      form.submit();
    }
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('[data-trilogy-all]')) return;
    items.forEach((li) => { const cb = li.querySelector('input[type=checkbox]'); if (!cb.disabled) cb.checked = true; });
    update();
    form.requestSubmit ? form.requestSubmit() : form.dispatchEvent(new Event('submit', { cancelable: true }));
  });
})();
</script>
{%- endif -%}
