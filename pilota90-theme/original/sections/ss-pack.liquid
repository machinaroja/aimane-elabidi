{%- comment %} PILOTA90 — Accueil : LE PACK COMPLET (dynamique) {% endcomment -%}
<style>
  .ss-pack{ --night:#0A1310; --surface:#13241D; --surface2:#182E24; --gold:#F4B740; --chalk:#F1EEE6; --muted:#8FA396; --red:#D64545;
    box-sizing:border-box; background:var(--night); color:var(--chalk); font-family:'Inter',sans-serif; padding:64px 20px; border-top:1px solid rgba(255,255,255,.05); }
  .ss-pack *,.ss-pack *::before,.ss-pack *::after{ box-sizing:border-box; }
  .ss-pack .panel{ position:relative; overflow:hidden; max-width:1000px; margin:0 auto; background:var(--surface); border:1px solid rgba(244,183,64,.35); border-radius:24px; display:grid; grid-template-columns:1fr; }
  .ss-pack .panel::before{ content:''; position:absolute; inset:0; pointer-events:none; background:radial-gradient(70% 60% at 100% 0%, rgba(244,183,64,.16), rgba(10,19,16,0) 60%); }
  .ss-pack .media{ position:relative; background:var(--surface2); display:flex; align-items:center; justify-content:center; padding:32px; min-height:280px; }
  .ss-pack .media img{ display:block; max-width:72%; width:auto; height:auto !important; max-height:540px; object-fit:contain; aspect-ratio:auto; border-radius:10px; box-shadow:0 24px 50px -22px rgba(0,0,0,.8); }
  .ss-pack .tag{ position:absolute; top:16px; left:16px; background:var(--red); color:#FFF7F0; box-shadow:0 6px 18px -6px rgba(214,69,69,.55); font-family:'Oswald',sans-serif; font-weight:600; letter-spacing:.04em; font-size:12px; padding:6px 12px; border-radius:999px; }
  .ss-pack .content{ position:relative; padding:36px 28px 40px; }
  .ss-pack .eyebrow{ font-family:'Oswald',sans-serif; letter-spacing:.24em; text-transform:uppercase; font-size:11px; font-weight:500; color:var(--gold); margin:0; }
  .ss-pack h2{ font-family:'Fraunces',serif; font-weight:500; font-size:clamp(28px,6vw,42px); line-height:1.08; margin:10px 0 14px; letter-spacing:-.01em; }
  .ss-pack .desc{ color:var(--muted); font-size:15px; line-height:1.6; margin:0 0 20px; }
  .ss-pack .inc{ font-family:'Oswald',sans-serif; letter-spacing:.14em; text-transform:uppercase; font-size:11px; color:var(--muted); margin:0 0 12px; }
  .ss-pack ul{ list-style:none; padding:0; margin:0 0 24px; display:flex; flex-direction:column; gap:11px; }
  .ss-pack li{ display:flex; align-items:flex-start; gap:11px; font-size:14.5px; color:var(--chalk); }
  .ss-pack li svg{ flex:none; margin-top:2px; }
  .ss-pack .buy{ display:flex; align-items:center; gap:18px; flex-wrap:wrap; }
  .ss-pack .price-wrap{ display:flex; flex-direction:column; }
  .ss-pack .price{ font-family:'Oswald',sans-serif; font-weight:600; font-size:30px; color:var(--chalk); line-height:1; }
  .ss-pack .compare{ font-size:12.5px; color:var(--muted); margin-top:4px; }
  .ss-pack .btn{ display:inline-block; background:var(--gold); color:var(--night); border-radius:999px; padding:15px 30px; font-family:'Oswald',sans-serif; font-weight:600; letter-spacing:.04em; font-size:15px; text-decoration:none; transition:transform .2s, box-shadow .3s; }
  .ss-pack .btn:hover{ transform:translateY(-2px); box-shadow:0 16px 40px -12px rgba(244,183,64,.5); }
  .ss-pack .re{ margin:16px 0 0; font-size:12.5px; color:var(--muted); }
  @media(min-width:800px){ .ss-pack .panel{ grid-template-columns:0.9fr 1.1fr; } .ss-pack .content{ padding:44px 40px; } }
</style>
{%- assign pack = all_products[section.settings.pack_handle] -%}
<div class="ss-pack">
  <div class="panel">
    <div class="media">
      {%- if section.settings.badge != blank -%}<span class="tag">{{ section.settings.badge }}</span>{%- endif -%}
      {%- if pack.featured_image -%}
        <img src="{{ pack.featured_image | image_url: width: 700 }}" alt="{{ pack.title | escape }}" loading="lazy" width="{{ pack.featured_image.width }}" height="{{ pack.featured_image.height }}">
      {%- endif -%}
    </div>
    <div class="content">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p class="desc">{{ section.settings.description }}</p>
      <p class="inc">Les 5 guides inclus</p>
      <ul>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F4B740" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ section.settings.g1 }}</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F4B740" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ section.settings.g2 }}</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F4B740" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ section.settings.g3 }}</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F4B740" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ section.settings.g4 }}</li>
        <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F4B740" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ section.settings.g5 }}</li>
      </ul>
      <div class="buy">
        <span class="price-wrap">
          <span class="price">{{ pack.price | money }}</span>
          <span class="compare">{{ section.settings.compare_note }}</span>
        </span>
        <a href="{{ pack.url }}" class="btn">{{ section.settings.button_label }}</a>
      </div>
      <p class="re">{{ section.settings.reassurance }}</p>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Accueil — Pack Complet",
  "settings": [
    { "type": "text", "id": "pack_handle", "label": "Handle du produit Pack", "default": "pilota90-pack-complet-5-guides-pdf" },
    { "type": "text", "id": "badge", "label": "Badge (coin image)", "default": "−50 %" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "L'offre complète" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le Pack Complet — 5 guides" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "La méthode PILOTA90 réunie en un seul pack : plus de 150 pages d'outils concrets pour la motivation, la confiance, la communication, le mental collectif et l'intelligence de jeu. Pour tous les sports, du jeune sportif à l'athlète confirmé." },
    { "type": "text", "id": "g1", "label": "Guide 1", "default": "La Motivation dans le Sport" },
    { "type": "text", "id": "g2", "label": "Guide 2", "default": "Communiquer pour Performer" },
    { "type": "text", "id": "g3", "label": "Guide 3", "default": "Confiance en Soi & Résilience de l'Athlète" },
    { "type": "text", "id": "g4", "label": "Guide 4", "default": "La Force Mentale des Équipes qui Gagnent" },
    { "type": "text", "id": "g5", "label": "Guide 5", "default": "L'Intelligence de Jeu — prise de décision" },
    { "type": "text", "id": "compare_note", "label": "Note prix", "default": "au lieu de 79,50 € à l'unité (−50 %)" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Obtenir le Pack Complet" },
    { "type": "text", "id": "reassurance", "label": "Réassurance", "default": "Paiement unique · Accès à vie · Satisfait ou remboursé 14 jours" }
  ],
  "presets": [{ "name": "Accueil — Pack Complet" }]
}
{% endschema %}
