{%- comment %} PILOTA90 — Produit : CTA FINAL (remonte vers l'achat natif) {% endcomment -%}
<style>
  .ssp-cta{ --night:#0A1310; --gold:#F4B740; --chalk:#F1EEE6; --muted:#8FA396;
    box-sizing:border-box; position:relative; overflow:hidden; background:var(--night); color:var(--chalk); font-family:'Inter',sans-serif; padding:64px 20px; text-align:center; border-top:1px solid rgba(255,255,255,.05); }
  .ssp-cta *,.ssp-cta *::before,.ssp-cta *::after{ box-sizing:border-box; }
  .ssp-cta .glow{ position:absolute; inset:0; pointer-events:none; background:radial-gradient(60% 60% at 50% 100%, rgba(244,183,64,.20) 0%, rgba(244,183,64,.05) 34%, rgba(10,19,16,0) 72%); }
  .ssp-cta .in{ position:relative; max-width:620px; margin:0 auto; }
  .ssp-cta h2{ font-family:'Fraunces',serif; font-weight:500; font-size:clamp(26px,6vw,42px); line-height:1.1; margin:0; letter-spacing:-.01em; }
  .ssp-cta h2 .em{ color:var(--gold); font-style:italic; }
  .ssp-cta p{ color:var(--muted); font-size:15px; line-height:1.6; margin:16px auto 0; max-width:440px; }
  .ssp-cta .btn{ display:inline-block; margin-top:28px; background:var(--gold); color:var(--night); border-radius:999px; padding:16px 34px; font-family:'Oswald',sans-serif; font-weight:600; letter-spacing:.04em; font-size:16px; text-decoration:none; transition:transform .2s,box-shadow .3s; }
  .ssp-cta .btn:hover{ transform:translateY(-2px); box-shadow:0 16px 40px -12px rgba(244,183,64,.5); }
  .ssp-cta .re{ display:flex; flex-wrap:wrap; gap:12px 20px; justify-content:center; margin-top:26px; }
  .ssp-cta .re span{ display:inline-flex; align-items:center; gap:7px; font-size:12.5px; color:var(--muted); }
  @media(prefers-reduced-motion:reduce){ .ssp-cta .btn{ transition:none; } }
</style>
<div class="ssp-cta">
  <div class="glow"></div>
  <div class="in">
    <h2>{{ section.settings.heading_before }} <span class="em">{{ section.settings.heading_highlight }}</span></h2>
    <p>{{ section.settings.subtext }}</p>
    <a href="#MainContent" class="btn ps-cta">{{ section.settings.button_label }}</a>
    <div class="re">
      <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F4B740" stroke-width="1.8"><path d="M20 6L9 17l-5-5"/></svg>Téléchargement immédiat</span>
      <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F4B740" stroke-width="1.8"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>Paiement sécurisé</span>
      <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F4B740" stroke-width="1.8"><path d="M20 6L9 17l-5-5"/></svg>Satisfait ou remboursé</span>
    </div>
  </div>
</div>
{{ 'pilota-anim.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pilota-anim.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Produit — CTA final",
  "settings": [
    { "type": "text", "id": "heading_before", "label": "Titre", "default": "Prêt à passer" },
    { "type": "text", "id": "heading_highlight", "label": "Titre (or)", "default": "un cap ?" },
    { "type": "textarea", "id": "subtext", "label": "Sous-texte", "default": "Reçu tout de suite, lu ce soir. Applicable dès la prochaine séance." },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Obtenir ce guide" }
  ],
  "presets": [{ "name": "Produit — CTA final" }]
}
{% endschema %}
