{%- comment %} PILOTA90 — Accueil : LA MÉTHODE EN VISUELS v2 (animé, interactif, 3D tilt) {% endcomment -%}
<style>
  .ss-charts{ --paper:#FFFFFF; --paper2:#F5F7FA; --navy:#152D52; --navydeep:#0B1E38; --muted:#3E4E63; --goldink:#C9962B; --gold:#F4B740; --red:#D64545;
    box-sizing:border-box; background:var(--paper); color:var(--navy); font-family:'Inter',sans-serif; padding:64px 20px; border-top:1px solid rgba(16,40,74,.08); }
  .ss-charts *,.ss-charts *::before,.ss-charts *::after{ box-sizing:border-box; }
  .ss-charts .head{ max-width:660px; margin:0 auto 36px; text-align:center; }
  .ss-charts .eyebrow{ font-family:'Oswald',sans-serif; letter-spacing:.24em; text-transform:uppercase; font-size:11px; font-weight:500; color:#C13333; margin:0; }
  .ss-charts h2{ font-family:'Oswald',sans-serif; font-weight:600; font-size:clamp(24px,5vw,36px); line-height:1.15; margin:12px 0 10px; letter-spacing:.01em; }
  .ss-charts .sub{ color:var(--muted); font-size:15px; line-height:1.6; margin:0; }
  .ss-charts .duo{ display:grid; grid-template-columns:1fr; gap:18px; max-width:1000px; margin:0 auto 18px; perspective:1100px; }
  @media(min-width:820px){ .ss-charts .duo{ grid-template-columns:1fr 1fr; } }
  .ss-charts .panel{ background:var(--paper2); border:1px solid rgba(16,40,74,.08); border-radius:20px; padding:26px 20px 22px; text-align:center;
    transition:transform .4s cubic-bezier(.2,.8,.25,1), box-shadow .4s; transform-style:preserve-3d; }
  .ss-charts .panel:hover{ transform:rotateX(4deg) rotateY(-4deg) translateY(-6px); box-shadow:0 28px 56px -26px rgba(11,30,56,.4); }
  .ss-charts .ptitle{ font-family:'Oswald',sans-serif; font-weight:600; font-size:15px; letter-spacing:.06em; text-transform:uppercase; margin:0 0 14px; }
  .ss-charts svg{ max-width:100%; height:auto; display:block; margin:0 auto; }
  .ss-charts .legend{ display:flex; justify-content:center; flex-wrap:wrap; gap:14px 18px; margin-top:10px; font-size:12.5px; color:var(--muted); }
  .ss-charts .dot{ display:inline-block; width:10px; height:10px; border-radius:50%; margin-right:6px; vertical-align:-1px; }
  .ss-charts .note{ font-size:12px; color:var(--muted); margin:10px 0 0; }
  .ss-charts .cmp-wrap{ max-width:1000px; margin:0 auto; overflow-x:auto; }
  .ss-charts table.cmp{ width:100%; background:#FFFFFF; border:1px solid rgba(16,40,74,.10); border-radius:20px; overflow:hidden; border-collapse:separate; border-spacing:0; }
  .ss-charts .cmp th{ font-family:'Oswald',sans-serif; font-weight:600; font-size:13px; letter-spacing:.08em; text-transform:uppercase; padding:14px 12px; background:linear-gradient(120deg,#0B1E38,#16345E); color:#F5F7FA; }
  .ss-charts .cmp th:first-child{ text-align:left; }
  .ss-charts .cmp td{ padding:13px 12px; font-size:14.5px; border-top:1px solid rgba(16,40,74,.08); text-align:center; color:var(--muted); transition:background .25s; }
  .ss-charts .cmp td:first-child{ text-align:left; color:var(--navy); font-weight:500; }
  .ss-charts .cmp tr:nth-child(even) td{ background:var(--paper2); }
  .ss-charts .cmp td.colb{ background:rgba(244,183,64,.10); }
  .ss-charts .cmp tbody tr:hover td{ background:rgba(244,183,64,.16); }
  .ss-charts .no{ color:var(--red); font-weight:700; margin-right:6px; }
  .ss-charts .yes{ color:var(--goldink); font-weight:700; margin-right:6px; }

  /* --- Animations --- */
  .ss-charts .r-red{ stroke-dasharray:700; stroke-dashoffset:700; fill-opacity:0; animation:p90draw 1.1s ease-out .15s forwards, p90fill .7s ease 1s forwards; }
  .ss-charts .r-gold{ stroke-dasharray:1000; stroke-dashoffset:1000; fill-opacity:0; animation:p90draw 1.5s ease-out .35s forwards, p90fill .8s ease 1.4s forwards; }
  .ss-charts .vdot{ transform-box:fill-box; transform-origin:center; animation:p90pulse 2.2s ease-in-out infinite; }
  .ss-charts .vdot:nth-of-type(2){ animation-delay:.3s } .ss-charts .vdot:nth-of-type(3){ animation-delay:.6s } .ss-charts .vdot:nth-of-type(4){ animation-delay:.9s } .ss-charts .vdot:nth-of-type(5){ animation-delay:1.2s }
  .ss-charts .dq{ stroke-dasharray:100; stroke-dashoffset:100; animation:p90arc 1s ease-out forwards; }
  .ss-charts .dq2{ animation-delay:.15s } .ss-charts .dq3{ animation-delay:.3s } .ss-charts .dq4{ animation-delay:.5s }
  .ss-charts .dcore{ animation:p90glow 2.6s ease-in-out infinite; }
  @keyframes p90draw{ to{ stroke-dashoffset:0; } }
  @keyframes p90arc{ to{ stroke-dashoffset:0; } }
  @keyframes p90fill{ to{ fill-opacity:1; } }
  @keyframes p90pulse{ 0%,100%{ transform:scale(1); opacity:1; } 50%{ transform:scale(1.6); opacity:.45; } }
  @keyframes p90glow{ 0%,100%{ opacity:1; } 50%{ opacity:.55; } }
  @media(prefers-reduced-motion:reduce){
    .ss-charts .r-red,.ss-charts .r-gold{ animation:none; stroke-dashoffset:0; fill-opacity:1; }
    .ss-charts .dq{ animation:none; stroke-dashoffset:0; }
    .ss-charts .vdot,.ss-charts .dcore{ animation:none; }
    .ss-charts .panel, .ss-charts .panel:hover{ transform:none; }
  }
</style>
<div class="ss-charts">
  <div class="head">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p class="sub">{{ section.settings.subheading }}</p>
  </div>
  <div class="duo">
    <div class="panel">
      <p class="ptitle">Le profil mental complet</p>
      <svg viewBox="0 0 340 300" width="340" height="300" role="img" aria-label="Radar des 5 piliers du mental">
        <g stroke="rgba(16,40,74,.15)" fill="none" stroke-width="1">
          <polygon points="170,40 274.6,116 234.7,239 105.3,239 65.4,116"/>
          <polygon points="170,67.5 248.5,124.5 218.5,216.7 121.5,216.7 91.5,124.5"/>
          <polygon points="170,95 222.3,133 202.3,194.5 137.7,194.5 117.7,133"/>
          <polygon points="170,122.5 196.2,141.5 186.2,172.2 153.8,172.2 143.8,141.5"/>
          <line x1="170" y1="150" x2="170" y2="40"/>
          <line x1="170" y1="150" x2="274.6" y2="116"/>
          <line x1="170" y1="150" x2="234.7" y2="239"/>
          <line x1="170" y1="150" x2="105.3" y2="239"/>
          <line x1="170" y1="150" x2="65.4" y2="116"/>
        </g>
        <polygon class="r-red" points="170,103.8 209.8,137.1 199.7,190.9 148,180.3 128.2,136.4" fill="rgba(214,69,69,.16)" stroke="#D64545" stroke-width="1.6"/>
        <polygon class="r-gold" points="170,48.8 262.1,120.1 225,225.6 111.8,230.1 80,120.8" fill="rgba(244,183,64,.30)" stroke="#C9962B" stroke-width="2.2"/>
        <g fill="#C9962B">
          <circle class="vdot" cx="170" cy="48.8" r="4"/>
          <circle class="vdot" cx="262.1" cy="120.1" r="4"/>
          <circle class="vdot" cx="225" cy="225.6" r="4"/>
          <circle class="vdot" cx="111.8" cy="230.1" r="4"/>
          <circle class="vdot" cx="80" cy="120.8" r="4"/>
        </g>
        <g font-family="Oswald,sans-serif" font-size="11.5" fill="#152D52" letter-spacing=".04em">
          <text x="170" y="26" text-anchor="middle">MOTIVATION</text>
          <text x="281" y="110" text-anchor="start">CONFIANCE</text>
          <text x="240" y="260" text-anchor="middle">CONCENTRATION</text>
          <text x="100" y="260" text-anchor="middle">COMMUNICATION</text>
          <text x="59" y="110" text-anchor="end">STRESS</text>
        </g>
      </svg>
      <div class="legend">
        <span><span class="dot" style="background:#D64545"></span>Mental non entraîné</span>
        <span><span class="dot" style="background:#C9962B"></span>Mental entraîné</span>
      </div>
      <p class="note">Illustration pédagogique des 5 piliers travaillés dans les guides.</p>
    </div>
    <div class="panel">
      <p class="ptitle">Les 4 dimensions de la performance</p>
      <svg viewBox="0 0 320 300" width="320" height="300" role="img" aria-label="Les 4 dimensions de la performance sportive">
        <g fill="none" stroke-width="40" stroke-linecap="butt">
          <path class="dq dq2" pathLength="100" d="M248,150 A88,88 0 0 1 160,238" stroke="#152D52"/>
          <path class="dq dq3" pathLength="100" d="M160,238 A88,88 0 0 1 72,150" stroke="#5B6B7C"/>
          <path class="dq dq4" pathLength="100" d="M72,150 A88,88 0 0 1 160,62" stroke="#B7C3D2"/>
          <path class="dq" pathLength="100" d="M160,62 A88,88 0 0 1 248,150" stroke="#F4B740" transform="translate(8,-8)"/>
        </g>
        <g class="dcore" font-family="Oswald,sans-serif" text-anchor="middle">
          <text x="160" y="146" font-size="17" font-weight="700" fill="#C9962B" letter-spacing=".08em">MENTAL</text>
          <text x="160" y="166" font-size="11" fill="#3E4E63" font-family="Inter,sans-serif">le pilier oublié</text>
        </g>
      </svg>
      <div class="legend">
        <span><span class="dot" style="background:#F4B740"></span>Mental</span>
        <span><span class="dot" style="background:#152D52"></span>Technique</span>
        <span><span class="dot" style="background:#5B6B7C"></span>Physique</span>
        <span><span class="dot" style="background:#B7C3D2"></span>Environnement</span>
      </div>
      <p class="note">Quatre dimensions à développer — une seule est rarement entraînée.</p>
    </div>
  </div>
  <div class="cmp-wrap">
    <table class="cmp">
      <thead>
        <tr><th>Situation</th><th>Sans méthode</th><th>Avec PILOTA90</th></tr>
      </thead>
      <tbody>
        <tr><td>La pression du jour J</td><td><span class="no">✗</span>Subie</td><td class="colb"><span class="yes">✓</span>Canalisée en énergie</td></tr>
        <tr><td>Après une erreur</td><td><span class="no">✗</span>Spirale négative</td><td class="colb"><span class="yes">✓</span>Routine de rebond</td></tr>
        <tr><td>La motivation sur la saison</td><td><span class="no">✗</span>En dents de scie</td><td class="colb"><span class="yes">✓</span>Entretenue méthodiquement</td></tr>
        <tr><td>La concentration en compétition</td><td><span class="no">✗</span>Décrochages</td><td class="colb"><span class="yes">✓</span>Routines de recentrage</td></tr>
        <tr><td>Le rôle des parents</td><td><span class="no">✗</span>Pression involontaire</td><td class="colb"><span class="yes">✓</span>Soutien structuré</td></tr>
      </tbody>
    </table>
  </div>
</div>
{% schema %}
{
  "name": "Accueil — Visuels méthode",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "La méthode en un coup d'œil" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce que le mental change, visuellement" },
    { "type": "textarea", "id": "subheading", "label": "Sous-titre", "default": "Cinq piliers, quatre dimensions, un avant/après concret — voilà le terrain de jeu des guides PILOTA90." }
  ],
  "presets": [{ "name": "Accueil — Visuels méthode" }]
}
{% endschema %}
