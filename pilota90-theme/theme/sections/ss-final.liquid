{%- comment %} PILOTA90 — Accueil : CTA FINAL {% endcomment -%}
<style>
  .ss-final{ --night:#0A1310; --gold:#F4B740; --chalk:#F1EEE6; --muted:#8FA396;
    box-sizing:border-box; position:relative; overflow:hidden; background:var(--night); color:var(--chalk); font-family:'Inter',sans-serif; padding:80px 20px; text-align:center; border-top:1px solid rgba(255,255,255,.05); }
  .ss-final *,.ss-final *::before,.ss-final *::after{ box-sizing:border-box; }
  .ss-final .lines{ position:absolute; inset:0; pointer-events:none; background-image:linear-gradient(rgba(241,238,230,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(241,238,230,.04) 1px,transparent 1px); background-size:56px 56px; }
  .ss-final .glow{ position:absolute; inset:0; pointer-events:none; background:radial-gradient(60% 70% at 50% 100%, rgba(244,183,64,.22), rgba(10,19,16,0) 65%); }
  .ss-final .in{ position:relative; max-width:620px; margin:0 auto; }
  .ss-final h2{ font-family:'Fraunces',serif; font-weight:500; font-size:clamp(30px,7vw,52px); line-height:1.05; margin:0; letter-spacing:-.015em; }
  .ss-final h2 .em{ color:var(--gold); font-style:italic; }
  .ss-final p{ color:var(--muted); font-size:16px; line-height:1.6; margin:18px auto 0; max-width:480px; }
  .ss-final .btn{ display:inline-block; margin-top:30px; background:var(--gold); color:var(--night); border-radius:999px; padding:17px 38px; font-family:'Oswald',sans-serif; font-weight:600; letter-spacing:.04em; font-size:16px; text-decoration:none; transition:transform .2s, box-shadow .3s; }
  .ss-final .btn:hover{ transform:translateY(-2px); box-shadow:0 18px 44px -12px rgba(244,183,64,.55); }
  .ss-final .re{ margin-top:22px; font-size:12.5px; color:var(--muted); }
</style>
<div class="ss-final">
  <div class="lines"></div>
  <div class="glow"></div>
  <div class="in">
    <h2>{{ section.settings.heading_before }} <span class="em">{{ section.settings.heading_highlight }}</span></h2>
    <p>{{ section.settings.subtext }}</p>
    <a href="/products/pack-mental-complet-les-5-leviers-pour-que-votre-enfant-donne-son-vrai-niveau-le-jour-j" class="btn">{{ section.settings.button_label }}</a>
    <p class="re">{{ section.settings.reassurance }}</p>
  </div>
</div>
{% schema %}
{
  "name": "Accueil — CTA final",
  "settings": [
    { "type": "text", "id": "heading_before", "label": "Titre", "default": "La prochaine compétition se prépare" },
    { "type": "text", "id": "heading_highlight", "label": "Titre (or)", "default": "maintenant." },
    { "type": "textarea", "id": "subtext", "label": "Sous-texte", "default": "Donne à ton sportif — jeune ou confirmé — l'avantage que les autres n'ont pas : un mental entraîné." },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir le Pack Complet" },
    { "type": "text", "id": "reassurance", "label": "Réassurance", "default": "Accès immédiat · Paiement sécurisé · Satisfait ou remboursé" }
  ],
  "presets": [{ "name": "Accueil — CTA final" }]
}
{% endschema %}
