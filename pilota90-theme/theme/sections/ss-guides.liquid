{%- comment %} PILOTA90 — Accueil : GRILLE DES GUIDES (sélection courte + bouton vers la collection complète) {% endcomment -%}
<style>
  .ss-guides{ --night:#0E1A15; --surface:#13241D; --surface2:#182E24; --gold:#F4B740; --chalk:#F1EEE6; --muted:#8FA396;
    box-sizing:border-box; background:var(--night); color:var(--chalk); font-family:'Inter',sans-serif; padding:64px 20px; border-top:1px solid rgba(255,255,255,.05); }
  .ss-guides *,.ss-guides *::before,.ss-guides *::after{ box-sizing:border-box; }
  .ss-guides .head{ max-width:640px; margin:0 auto 36px; text-align:center; }
  .ss-guides .eyebrow{ font-family:'Oswald',sans-serif; letter-spacing:.24em; text-transform:uppercase; font-size:11px; font-weight:500; color:var(--gold); margin:0; }
  .ss-guides h2{ font-family:'Fraunces',serif; font-weight:500; font-size:clamp(26px,6vw,40px); line-height:1.12; margin:12px 0 10px; letter-spacing:-.01em; }
  .ss-guides .sub{ color:var(--muted); font-size:15px; line-height:1.6; margin:0; }
  .ss-guides .grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:14px; max-width:1080px; margin:0 auto; }
  .ss-guides .card{ display:flex; flex-direction:column; background:var(--surface); border:1px solid rgba(241,238,230,.08); border-radius:16px; overflow:hidden; text-decoration:none; color:inherit; transition:transform .2s, border-color .25s, box-shadow .3s; }
  .ss-guides .card:hover{ transform:translateY(-4px); border-color:rgba(244,183,64,.5); box-shadow:0 18px 40px -20px rgba(0,0,0,.7); }
  .ss-guides .cover{ aspect-ratio:2/3; background:var(--surface2); overflow:hidden; position:relative; }
  .ss-guides .cover img{ display:block; width:100%; height:100%; object-fit:cover; object-position:center; transition:transform .35s ease; }
  .ss-guides .card:hover .cover img{ transform:scale(1.04); }
  .ss-guides .badges{ position:absolute; top:10px; left:10px; display:flex; flex-direction:column; align-items:flex-start; gap:6px; z-index:2; }
  .ss-guides .badge{ font-family:'Oswald',sans-serif; font-size:10.5px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; line-height:1; padding:6px 10px; border-radius:999px; box-shadow:0 4px 12px rgba(0,0,0,.25); }
  .ss-guides .badge--promo{ background:#C13333; color:#FFFFFF; }
  .ss-guides .badge--best{ background:#F4B740; color:#0B1E38; }
  .ss-guides .body{ padding:16px 16px 20px; display:flex; flex-direction:column; gap:8px; flex:1; }
  .ss-guides .title{ font-family:'Oswald',sans-serif; font-weight:500; font-size:15px; line-height:1.25; letter-spacing:.01em; }
  .ss-guides .foot{ margin-top:auto; display:flex; align-items:center; justify-content:space-between; }
  .ss-guides .prices{ display:flex; align-items:baseline; gap:8px; flex-wrap:wrap; }
  .ss-guides .compare{ font-family:'Oswald',sans-serif; font-weight:500; font-size:13px; color:#9AA7A0; text-decoration:line-through; }
  .ss-guides .price{ font-family:'Oswald',sans-serif; font-weight:600; color:var(--gold); font-size:16px; }
  .ss-guides .price--sale{ color:#C13333; }
  .ss-guides .arrow{ color:var(--muted); transition:transform .2s, color .2s; }
  .ss-guides .card:hover .arrow{ color:var(--gold); transform:translateX(3px); }
  .ss-guides .more{ text-align:center; margin-top:28px; }
  .ss-guides .btn{ display:inline-block; border-radius:999px; padding:14px 28px; font-family:'Oswald',sans-serif; font-weight:600; font-size:15px; letter-spacing:.04em; text-decoration:none; background:var(--gold); color:#0B1E38; transition:transform .2s, box-shadow .3s; }
  .ss-guides .btn:hover{ transform:translateY(-2px); }
  @media(min-width:700px){ .ss-guides .grid{ grid-template-columns:repeat(3,1fr); gap:18px; } }
  @media(min-width:1000px){ .ss-guides .grid{ grid-template-columns:repeat(4,1fr); } .ss-guides .grid.grid--3{ grid-template-columns:repeat(3,1fr); max-width:960px; } }
  @media(prefers-reduced-motion:reduce){ .ss-guides .cover img{ transition:none; } .ss-guides .card:hover .cover img{ transform:none; } }
</style>
{%- liquid
  assign col = collections[section.settings.collection]
  assign picks = section.settings.featured_products
  assign limit = section.settings.limit | default: 6
  assign total = 0
  for p in col.products
    unless p.handle contains 'pack'
      assign total = total | plus: 1
    endunless
  endfor
  assign grid_class = 'grid'
  if limit <= 6
    assign grid_class = 'grid grid--3'
  endif
  assign btn_label = section.settings.button_label | default: 'Voir tous les guides' | replace: '[N]', total
-%}
<div class="ss-guides" id="ss-guides">
  <div class="head">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p class="sub">{{ section.settings.subheading }}</p>
  </div>
  <div class="{{ grid_class }}">
    {%- if picks.size > 0 -%}
      {%- for product in picks limit: limit -%}
        {%- render 'p90-guide-card', product: product -%}
      {%- endfor -%}
    {%- else -%}
      {%- assign shown = 0 -%}
      {%- for product in col.products -%}
        {%- unless product.handle contains 'pack' -%}
          {%- if shown < limit -%}
            {%- render 'p90-guide-card', product: product -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
  {%- if section.settings.show_all_button and total > limit -%}
  <div class="more">
    <a class="btn" href="{{ col.url }}">{{ btn_label }} →</a>
  </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Accueil — Guides",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection à afficher" },
    { "type": "product_list", "id": "featured_products", "label": "Sélection mise en avant (sinon : premiers guides de la collection)", "limit": 8 },
    { "type": "range", "id": "limit", "label": "Nombre de guides affichés", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_all_button", "label": "Afficher le bouton vers tous les guides", "default": true },
    { "type": "text", "id": "button_label", "label": "Texte du bouton ([N] = nombre de guides)", "default": "Voir les [N] guides" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "La bibliothèque" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Des guides ciblés, un seul objectif : la performance" },
    { "type": "textarea", "id": "subheading", "label": "Sous-titre", "default": "Chaque guide traite un levier précis. Commencez par celui qui vous parle le plus." }
  ],
  "presets": [{ "name": "Accueil — Guides" }]
}
{% endschema %}
