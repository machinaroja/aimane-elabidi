{%- comment %} PILOTA90 — Accueil : HERO v2 (Oswald + entrée animée + marqueur doré). Liens des boutons réglables dans l'éditeur. {% endcomment -%}
<style>
  .ss-hero{ --night:#0A1310; --surface:#13241D; --gold:#F4B740; --goldsoft:#FBD778; --pitch:#2FA36B; --chalk:#F1EEE6; --muted:#8FA396;
    box-sizing:border-box; position:relative; overflow:hidden; background:var(--night); color:var(--chalk);
    font-family:'Inter',sans-serif; -webkit-font-smoothing:antialiased; padding:72px 20px 60px; text-align:center; }
  .ss-hero *,.ss-hero *::before,.ss-hero *::after{ box-sizing:border-box; }
  .ss-hero .bg{ position:absolute; inset:0; pointer-events:none; }
  .ss-hero .lines{ background-image:linear-gradient(rgba(241,238,230,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(241,238,230,.04) 1px,transparent 1px); background-size:56px 56px; }
  .ss-hero .glow{ background:radial-gradient(60% 50% at 50% 0%, rgba(244,183,64,.24) 0%, rgba(244,183,64,.08) 32%, rgba(10,19,16,0) 70%); }
  .ss-hero .in{ position:relative; max-width:820px; margin:0 auto; }
  .ss-hero .eyebrow{ font-family:'Oswald',sans-serif; letter-spacing:.26em; text-transform:uppercase; font-weight:500; font-size:11px; color:var(--gold); margin:0; }
  .ss-hero h1{ font-family:'Oswald',sans-serif; font-weight:700; text-transform:uppercase; font-size:clamp(34px,8.5vw,62px); line-height:1.06; margin:18px 0 0; letter-spacing:.015em; }
  .ss-hero .hl1{ display:block; opacity:0; transform:translateY(22px); animation:p90up .7s cubic-bezier(.2,.8,.25,1) .1s forwards; }
  .ss-hero h1 .em{ display:inline-block; position:relative; z-index:0; color:inherit; font-style:normal; padding:0 .08em; opacity:0; transform:translateY(22px); animation:p90up .7s cubic-bezier(.2,.8,.25,1) .3s forwards; }
  .ss-hero h1 .em::before{ content:""; position:absolute; z-index:-1; left:-1%; right:-1%; top:56%; bottom:4%; background:linear-gradient(90deg,#F4B740,#E39A2E); border-radius:5px; transform:scaleX(0); transform-origin:left center; animation:p90mark .7s cubic-bezier(.65,0,.35,1) .95s forwards; }
  .ss-hero .sub{ color:var(--muted); font-size:clamp(15px,4vw,18px); line-height:1.6; max-width:560px; margin:20px auto 0; }
  .ss-hero .sub,.ss-hero .cta,.ss-hero .badges{ opacity:0; transform:translateY(16px); animation:p90up .6s ease .5s forwards; }
  .ss-hero .cta{ animation-delay:.62s; }
  .ss-hero .badges{ animation-delay:.78s; }
  .ss-hero .cta{ display:flex; flex-direction:column; gap:12px; margin-top:32px; align-items:center; }
  .ss-hero .btn{ display:inline-block; border-radius:999px; font-family:'Oswald',sans-serif; font-weight:600; letter-spacing:.04em; text-decoration:none; transition:transform .2s,box-shadow .3s,border-color .25s; }
  .ss-hero .btn-gold{ background:var(--gold); color:var(--night); padding:16px 32px; font-size:16px; }
  .ss-hero .btn-gold:hover{ transform:translateY(-2px); box-shadow:0 16px 40px -12px rgba(244,183,64,.5); }
  .ss-hero .btn-ghost{ color:var(--chalk); padding:12px 22px; font-family:'Inter',sans-serif; font-weight:500; font-size:14px; border:1px solid rgba(241,238,230,.16); }
  .ss-hero .btn-ghost:hover{ border-color:rgba(241,238,230,.5); }
  .ss-hero .badges{ display:grid; grid-template-columns:repeat(2,1fr); gap:12px 8px; margin:36px auto 0; max-width:480px; }
  .ss-hero .badge{ display:flex; align-items:center; gap:8px; justify-content:center; font-size:12.5px; color:var(--muted); }
  .ss-hero .badge svg{ flex:none; }
  @keyframes p90up{ to{ opacity:1; transform:translateY(0); } }
  @keyframes p90mark{ to{ transform:scaleX(1); } }
  @media(min-width:640px){
    .ss-hero{ padding:100px 24px 80px; }
    .ss-hero .cta{ flex-direction:row; justify-content:center; }
    .ss-hero .badges{ grid-template-columns:repeat(4,auto); gap:24px; max-width:none; }
  }
  @media(prefers-reduced-motion:reduce){
    .ss-hero *{ transition:none!important; animation:none!important; }
    .ss-hero .hl1,.ss-hero h1 .em,.ss-hero .sub,.ss-hero .cta,.ss-hero .badges{ opacity:1; transform:none; }
    .ss-hero h1 .em::before{ transform:scaleX(1); }
  }
</style>
{%- liquid
  assign cta1 = section.settings.cta_primary_url | default: '/products/pack-mental-complet-les-5-leviers-pour-que-votre-enfant-donne-son-vrai-niveau-le-jour-j'
  assign cta2 = section.settings.cta_secondary_url | default: '#ss-guides'
-%}
<div class="ss-hero">
  <div class="bg lines"></div>
  <div class="bg glow"></div>
  <div class="in">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1><span class="hl1">{{ section.settings.heading_line1 }}</span> <span class="em">{{ section.settings.heading_highlight }}</span></h1>
    <p class="sub">{{ section.settings.subheading }}</p>
    <div class="cta">
      <a href="{{ cta1 }}" class="btn btn-gold">{{ section.settings.cta_primary_label }}</a>
      <a href="{{ cta2 }}" class="btn btn-ghost">{{ section.settings.cta_secondary_label }}</a>
    </div>
    <div class="badges">
      <div class="badge"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F4B740" stroke-width="1.8"><path d="M12 3v12m0 0l-4-4m4 4l4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>Accès immédiat (PDF)</div>
      <div class="badge"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F4B740" stroke-width="1.8"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>Paiement sécurisé</div>
      <div class="badge"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F4B740" stroke-width="1.8"><path d="M12 2l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4L4.2 7.7l5.4-.8z"/></svg>Conçu par un coach diplômé</div>
      <div class="badge"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F4B740" stroke-width="1.8"><path d="M20 6L9 17l-5-5"/></svg>Satisfait ou remboursé 14 jours</div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Accueil — Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Préparation mentale du sportif" },
    { "type": "text", "id": "heading_line1", "label": "Titre (ligne 1)", "default": "La performance se joue d'abord" },
    { "type": "text", "id": "heading_highlight", "label": "Titre (mot mis en avant, or)", "default": "dans la tête." },
    { "type": "textarea", "id": "subheading", "label": "Sous-titre", "default": "Stress, doute, motivation en dents de scie… Nos guides transforment le mental — du jeune sportif à l'athlète confirmé — en véritable avantage. Quelle que soit la discipline." },
    { "type": "text", "id": "cta_primary_label", "label": "Bouton principal — texte", "default": "Découvrir le guide n°1 des ventes" },
    { "type": "url", "id": "cta_primary_url", "label": "Bouton principal — lien" },
    { "type": "text", "id": "cta_secondary_label", "label": "Bouton secondaire — texte", "default": "Voir tous les guides" },
    { "type": "text", "id": "cta_secondary_url", "label": "Bouton secondaire — lien (ancre ou URL)", "default": "#ss-guides" }
  ],
  "presets": [{ "name": "Accueil — Hero" }]
}
{% endschema %}
