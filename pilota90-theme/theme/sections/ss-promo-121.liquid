{%- comment %} PILOTA90 — Bandeau promo permanent (sticky, sobre — Design pro 25.10) : jusqu'à 2 messages en rotation. Textes modifiables dans l'éditeur de thème. {% endcomment -%}
<style>
  #shopify-section-{{ section.id }}{ position:sticky; top:0; z-index:4; }
  .ss-promo121{ position:relative; box-sizing:border-box; background:#0B1E38; color:#F5F7FA; font-family:'Inter',sans-serif; text-align:center; padding:9px 16px; font-size:13px; line-height:1.4; border-bottom:1px solid rgba(244,183,64,.25); }
  .ss-promo121 .msgs{ display:grid; position:relative; }
  .ss-promo121 .msg{ grid-area:1 / 1; color:inherit; text-decoration:none; display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:4px 10px; transition:opacity .45s ease; }
  .ss-promo121 .msg:hover .big{ text-decoration:underline; text-underline-offset:3px; }
  .ss-promo121 .msg[aria-hidden="true"]{ opacity:0; visibility:hidden; pointer-events:none; }
  .ss-promo121 .tag{ border:1px solid rgba(244,183,64,.6); color:#F4B740; border-radius:999px; padding:2px 10px; font-family:'Oswald',sans-serif; font-size:10.5px; letter-spacing:.12em; text-transform:uppercase; font-weight:500; white-space:nowrap; }
  .ss-promo121 .big{ font-family:'Oswald',sans-serif; font-weight:600; letter-spacing:.04em; color:#F4B740; }
  .shopify-section-header-sticky{ top: var(--p121-offset, 38px) !important; }
  @media(min-width:640px){ .ss-promo121{ font-size:13.5px; } }
  @media(prefers-reduced-motion:reduce){ .ss-promo121 .msg{ transition:none !important; } }
</style>
{%- liquid
  assign link1 = section.settings.link | default: '/collections/ebooks-guides-pdf'
  assign link2 = section.settings.link2 | default: '/collections/packs'
  assign has2 = false
  if section.settings.highlight2 != blank or section.settings.text2 != blank
    assign has2 = true
  endif
-%}
<div class="ss-promo121" id="SsPromo121" data-rotate="{{ section.settings.rotate | default: 6 }}">
  <div class="msgs">
    <a class="msg" href="{{ link1 }}">
      {%- if section.settings.badge != blank -%}<span class="tag">{{ section.settings.badge }}</span>{%- endif -%}
      <span class="big">{{ section.settings.highlight }}</span>
      <span>{{ section.settings.text }}</span>
    </a>
    {%- if has2 -%}
    <a class="msg" href="{{ link2 }}" aria-hidden="true">
      {%- if section.settings.badge2 != blank -%}<span class="tag">{{ section.settings.badge2 }}</span>{%- endif -%}
      <span class="big">{{ section.settings.highlight2 }}</span>
      <span>{{ section.settings.text2 }}</span>
    </a>
    {%- endif -%}
  </div>
</div>
<script>
  (function(){
    var root = document.getElementById('SsPromo121');
    if(!root){ return; }
    var setOffset = function(){ document.documentElement.style.setProperty('--p121-offset', root.offsetHeight + 'px'); };
    window.addEventListener('resize', setOffset);
    if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', setOffset); } else { setOffset(); }
    var msgs = root.querySelectorAll('.msg');
    if(msgs.length < 2){ return; }
    var every = (parseInt(root.getAttribute('data-rotate'), 10) || 6) * 1000;
    var i = 0;
    setInterval(function(){
      msgs[i].setAttribute('aria-hidden', 'true');
      i = (i + 1) % msgs.length;
      msgs[i].removeAttribute('aria-hidden');
    }, every);
  })();
</script>
{% schema %}
{
  "name": "Bandeau promo permanent",
  "settings": [
    { "type": "header", "content": "Message 1" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Offre" },
    { "type": "text", "id": "highlight", "label": "Accroche", "default": "Le 3ᵉ guide offert" },
    { "type": "text", "id": "text", "label": "Texte", "default": "pour 2 guides achetés (le moins cher, hors packs)" },
    { "type": "url", "id": "link", "label": "Lien" },
    { "type": "header", "content": "Message 2 (optionnel, en rotation)" },
    { "type": "text", "id": "badge2", "label": "Badge", "default": "Pack" },
    { "type": "text", "id": "highlight2", "label": "Accroche", "default": "Pack Mental Complet" },
    { "type": "text", "id": "text2", "label": "Texte", "default": "5 guides à 69 € au lieu de 98,60 € à l'unité (−30 %)" },
    { "type": "url", "id": "link2", "label": "Lien" },
    { "type": "range", "id": "rotate", "label": "Rotation (secondes)", "min": 3, "max": 12, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Bandeau promo permanent" }]
}
{% endschema %}
