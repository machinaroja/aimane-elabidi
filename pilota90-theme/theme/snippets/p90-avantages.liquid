{%- comment -%}
  PILOTA90 — Grille des 4 avantages sous le bouton d'achat + style du bouton.
  Extrait tel quel du bloc Liquid d'origine.
{%- endcomment -%}
<style>
  .product-form__submit, .product-form__submit.button--secondary{ background:#C13333 !important; color:#FFFFFF !important; border:none !important; box-shadow:0 10px 26px -12px rgba(193,51,51,.6) !important; font-weight:600; letter-spacing:.04em; transition:transform .2s, box-shadow .25s, background .2s; }
  .product-form__submit:hover{ background:#D64545 !important; transform:translateY(-2px); box-shadow:0 16px 34px -12px rgba(214,69,69,.65) !important; }
  .p90-av{ display:grid; grid-template-columns:1fr 1fr; gap:10px; margin:16px 0 0; }
  .p90-av .c{ background:#FFFFFF; border:1px solid rgba(16,40,74,.10); border-radius:14px; padding:12px; display:flex; gap:10px; align-items:center; transition:transform .25s, box-shadow .25s, border-color .25s; }
  .p90-av .c:hover{ transform:translateY(-3px); box-shadow:0 14px 28px -16px rgba(11,30,56,.3); border-color:rgba(201,150,43,.5); }
  .p90-av .ic{ flex:none; width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center; }
  .p90-av .ic.g{ background:rgba(244,183,64,.18); }
  .p90-av .ic.n{ background:rgba(16,40,74,.10); }
  .p90-av .ic.r{ background:rgba(214,69,69,.14); }
  .p90-av .t{ display:flex; flex-direction:column; }
  .p90-av .t b{ font-size:12.5px; color:#152D52; font-family:'Oswald',sans-serif; font-weight:600; letter-spacing:.03em; text-transform:uppercase; line-height:1.2; }
  .p90-av .t span{ font-size:11.5px; color:#3E4E63; line-height:1.3; }
  @media(max-width:480px){ .p90-av .c{ padding:10px; } }
</style>
<div class="p90-av">
  <div class="c"><span class="ic g"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#C9962B" stroke-width="2" aria-hidden="true"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/></svg></span><span class="t"><b>PDF immédiat</b><span>Reçu juste après l'achat</span></span></div>
  <div class="c"><span class="ic n"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#152D52" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="12" height="16" rx="2"/><path d="M17 8h4v12h-8"/></svg></span><span class="t"><b>Multi-appareils</b><span>Téléphone, tablette, ordi</span></span></div>
  <div class="c"><span class="ic r"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#D64545" stroke-width="2" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3z"/></svg></span><span class="t"><b>Paiement sécurisé</b><span>Via Shopify</span></span></div>
  <div class="c"><span class="ic g"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#C9962B" stroke-width="2" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg></span><span class="t"><b>Garantie 14 jours</b><span>Satisfait ou remboursé</span></span></div>
</div>
