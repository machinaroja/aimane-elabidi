{%- comment %} PILOTA90 — Suivre le coach (Instagram + Facebook personnel) — v2 alignée {% endcomment -%}
<style>
  .p90-social{ display:flex; flex-direction:column; gap:10px; margin:14px 0 4px; padding:14px; border:1px solid rgba(16,40,74,.10); border-radius:14px; background:#F7F8FA; }
  .p90-social .lbl{ font-family:'Oswald',sans-serif; font-size:11.5px; letter-spacing:.08em; text-transform:uppercase; color:#3E4E63; font-weight:600; margin:0; line-height:1.2; }
  .p90-social .btns{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .p90-social a{ display:inline-flex; align-items:center; justify-content:center; gap:8px; width:100%; text-decoration:none; font-size:13.5px; font-weight:600; color:#152D52; padding:10px 12px; border-radius:999px; background:#FFFFFF; border:1px solid rgba(16,40,74,.14); box-shadow:0 1px 2px rgba(11,30,56,.06); transition:transform .15s, border-color .2s, box-shadow .2s; -webkit-tap-highlight-color:transparent; }
  .p90-social a:active{ transform:scale(.97); }
  @media(hover:hover){ .p90-social a:hover{ transform:translateY(-1px); border-color:#C9962B; box-shadow:0 8px 20px -14px rgba(11,30,56,.5); } }
  .p90-social svg{ width:17px; height:17px; flex:none; }
  @media(min-width:640px){
    .p90-social{ flex-direction:row; align-items:center; justify-content:space-between; padding:12px 16px; }
    .p90-social .btns{ display:flex; }
    .p90-social a{ width:auto; min-width:140px; }
  }
</style>
<div class="p90-social" aria-label="Suivre le coach PILOTA90">
  <p class="lbl">Le coach, sur le terrain</p>
  <div class="btns">
    <a href="https://www.instagram.com/elabidiaimane/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="#C13333" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="#C13333" stroke="none"/></svg>Instagram</a>
    <a href="https://www.facebook.com/aimane.elabidi" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="#1877F2" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.4c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.3H7.4V14h2.8v8h3.3z"/></svg>Facebook</a>
  </div>
</div>
