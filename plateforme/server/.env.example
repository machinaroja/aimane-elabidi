# Variables de la passerelle (production). NE JAMAIS commiter le fichier .env réel.
NODE_ENV=production
PORT=8787

# Adresse publique du site (https obligatoire) : sert aux liens de connexion envoyés par e-mail.
SITE_URL=https://app.as-lieusaint.example

# Projet Supabase (Project Settings > API)
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_ANON_KEY=...               # clé « anon » (publique par nature)
SUPABASE_SERVICE_ROLE_KEY=...       # clé « service_role » : SECRÈTE, uniquement sur le serveur, pour créer le compte d'une personne invitée
# SUPABASE_JWT_SECRET=...           # seulement pour un projet ancien qui signe encore en HS256

# Base de données : rôle « gateway » (jamais postgres / service_role). Pooler Supabase : utilisateur « gateway.VOTRE-PROJET ».
DATABASE_URL=postgresql://gateway:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
DATABASE_SSL=1
# DATABASE_SSL_CA=/chemin/vers/prod-ca-2021.crt    # certificat d'autorité de Supabase (Settings > Database > SSL)
# DATABASE_POOL_MAX=10

# Derrière un répartiteur de charge / un hébergeur (récupère la vraie adresse IP du visiteur pour la limitation de débit)
TRUST_PROXY=1
