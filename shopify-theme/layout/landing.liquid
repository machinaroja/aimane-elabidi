<form class="modal-form" id="modal-form" novalidate>
<div class="field">
<label for="f-name">Nom complet</label>
<input id="f-name" name="name" type="text" placeholder="Camille Martin" autocomplete="name" />
</div>
<div class="field">
<label for="f-email">E-mail</label>
<input id="f-email" name="email" type="email" placeholder="vous@email.com" autocomplete="email" />
</div>
<div class="field">
<label for="f-msg">Votre question</label>
<textarea id="f-msg" name="message" rows="3" placeholder="Quel guide correspond le mieux à la situation de mon enfant ?…"></textarea>
</div>
<button type="submit" class="modal-submit" id="modal-submit">Envoyer</button>
</form>
<div class="modal-success" id="modal-success" hidden>
<div class="s-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg></div>
<p class="s-title">Message enregistré</p>
<p class="s-text" id="modal-success-text">Merci — formulaire de démonstration, aucun message n’a été envoyé.</p>
<button type="button" class="pill v-solid" id="modal-done">Fermer</button>
</div>
