<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#1F3A32">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {%- if template.name == 'index' -%}
        {{ page_title }}
      {%- else -%}
        {{ page_title }}
        {%- if current_tags %} – {{ current_tags | join: ', ' }}{% endif -%}
        {%- if current_page != 1 %} – page {{ current_page }}{% endif -%}
        {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
      {%- endif -%}
    </title>
    {%- assign meta_description = page_description | default: shop.description | default: settings.default_description -%}
    {%- if meta_description != blank -%}
      <meta name="description" content="{{ meta_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {% render 'fonts' %}
    {{ 'bibliodor.css' | asset_url | stylesheet_tag }}
    <script>
      window.BIBLIODOR_STRINGS = {
        viewCart: {{ 'products.view_cart' | t | json }},
        added: {{ 'products.added' | t | json }},
        addError: {{ 'products.add_error' | t | json }}
      };
    </script>
    <script src="{{ 'bibliodor.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#contenu">{{ 'general.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    <main id="contenu" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    <p id="cart-status" class="visually-hidden" role="status" aria-live="polite"></p>
  </body>
</html>
