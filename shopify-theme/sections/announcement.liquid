{%- if section.settings.text != blank -%}
  <div class="announcement" role="note">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      {{ section.settings.text }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau d’annonce",
  "class": "announcement-section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Texte",
      "info": "Laisser vide pour masquer le bandeau. N’annoncez que des informations vérifiées."
    },
    { "type": "url", "id": "link", "label": "Lien (facultatif)" }
  ],
  "presets": [{ "name": "Bandeau d’annonce" }]
}
{% endschema %}
