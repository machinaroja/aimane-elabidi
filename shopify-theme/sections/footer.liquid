<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <img class="site-footer__logo" src="{{ 'logo-bibliodor-signature-640.png' | asset_url }}" width="240" height="45" alt="{{ shop.name }}, les idées qui valent de l’or" loading="lazy">
      {%- if section.settings.tagline != blank -%}<p>{{ section.settings.tagline }}</p>{%- endif -%}
    </div>
    {%- for block in section.blocks -%}
      {%- assign menu = linklists[block.settings.menu] -%}
      {%- if menu.links.size > 0 -%}
        <nav aria-labelledby="footer-{{ block.id }}" {{ block.shopify_attributes }}>
          <h2 id="footer-{{ block.id }}">{{ block.settings.heading | default: menu.title }}</h2>
          <ul>
            {%- for link in menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="wrap site-footer__base">
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    {%- if shop.policies.size > 0 -%}
      <p>
        {%- for policy in shop.policies -%}
          <a href="{{ policy.url }}">{{ policy.title }}</a>{% unless forloop.last %}<span aria-hidden="true"> · </span>{% endunless %}
        {%- endfor -%}
      </p>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "class": "footer-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "tagline", "label": "Phrase de présentation", "default": "Maison d’édition numérique. Des ebooks en français, écrits pour être utiles." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Colonne de liens",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
