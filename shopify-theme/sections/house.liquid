<section class="section wrap house" aria-labelledby="house-{{ section.id }}">
  <h2 id="house-{{ section.id }}">{{ section.settings.heading }}</h2>
  <div class="house__text">
    {%- if section.settings.lead != blank -%}<p class="house__lead">{{ section.settings.lead }}</p>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Texte de la maison",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Une maison d’édition, pas un entrepôt de fichiers" },
    { "type": "textarea", "id": "lead", "label": "Introduction", "default": "Chaque titre BIBLIODOR part d’une question précise que se posent nos lecteurs, et y répond avec méthode : des idées sourcées, des exemples concrets, un plan qui se suit." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Nous préférons un livre court qu’on termine à un pavé qu’on abandonne. Pas de promesses miracles, pas de remplissage : un texte relu, mis en page avec soin, qui respecte ton temps.</p>" },
    { "type": "text", "id": "link_label", "label": "Lien", "default": "Découvrir la maison" },
    { "type": "text", "id": "link", "label": "Adresse du lien", "default": "/pages/a-propos" }
  ],
  "presets": [{ "name": "Texte de la maison" }]
}
{% endschema %}
