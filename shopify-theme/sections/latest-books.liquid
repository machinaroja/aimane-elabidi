{%- assign source = section.settings.collection | default: collections.all -%}
<section class="section wrap" id="{{ section.settings.anchor | default: section.id }}" aria-labelledby="latest-{{ section.id }}">
  <header class="section-head section-head--row">
    <h2 id="latest-{{ section.id }}">{{ section.settings.heading }}</h2>
    <a class="text-link" href="{{ source.url }}">{{ section.settings.link_label }}</a>
  </header>
  {%- if source.products.size > 0 -%}
    <ul class="book-grid">
      {%- for product in source.products limit: section.settings.limit -%}
        {% render 'book-card', product: product %}
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p class="book-meta">{{ 'collections.empty' | t }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Grille de livres",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nouveautés" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Pour des nouveautés, triez la collection par date (du plus récent au plus ancien)." },
    { "type": "range", "id": "limit", "label": "Nombre de livres", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "link_label", "label": "Lien", "default": "Tout le catalogue" },
    { "type": "text", "id": "anchor", "label": "Ancre (identifiant de section)", "default": "nouveautes" }
  ],
  "presets": [{ "name": "Grille de livres" }]
}
{% endschema %}
