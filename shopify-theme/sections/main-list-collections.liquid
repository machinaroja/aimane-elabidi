<div class="section wrap">
  <header class="section-head">
    <h1 class="page-title">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
  </header>
  {%- assign list = section.settings.rayons | default: collections -%}
  <ol class="toc">
    {%- for c in list -%}
      {%- unless c.handle == 'all' or c.handle == 'a-la-une' or c.handle == 'frontpage' -%}
        {%- liquid
          case c.handle
            when 'developpement-personnel'
              assign emblem = 'steps'
            when 'argent'
              assign emblem = 'coin'
            when 'pouvoir-et-influence'
              assign emblem = 'column'
            else
              assign emblem = 'rings'
          endcase
        -%}
        <li>
          <a href="{{ c.url }}" class="toc__row">
            {% render 'emblem', name: emblem, class: 'toc__emblem' %}
            <span class="toc__main">
              <span class="toc__name">{{ c.title }}</span>
              {%- if c.description != blank -%}<span class="toc__summary">{{ c.description | strip_html | truncatewords: 20 }}</span>{%- endif -%}
            </span>
            <span class="toc__leader" aria-hidden="true"></span>
            <span class="toc__count">{{ 'collections.count' | t: count: c.products_count }}</span>
          </a>
        </li>
      {%- endunless -%}
    {%- endfor -%}
  </ol>
</div>

{% schema %}
{
  "name": "Liste des rayons",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Les rayons" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Quatre domaines, choisis parce qu’ils changent concrètement la vie de ceux qui s’y intéressent." },
    { "type": "collection_list", "id": "rayons", "label": "Rayons (dans l’ordre)", "limit": 12 }
  ]
}
{% endschema %}
