<div class="wrap page faq">
  <h1 class="page-title">{{ page.title }}</h1>
  {%- if page.content != blank -%}<div class="rte page-intro">{{ page.content }}</div>{%- endif -%}
  <div>
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <div class="rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
  {%- if section.settings.contact_text != blank -%}<div class="rte">{{ section.settings.contact_text }}</div>{%- endif -%}
</div>

{% schema %}
{
  "name": "Questions fréquentes",
  "settings": [
    { "type": "richtext", "id": "contact_text", "label": "Texte final", "default": "<p>Tu ne trouves pas ta réponse ? <a href=\"/pages/contact\">Écris-nous</a>.</p>" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Réponse" }
      ]
    }
  ]
}
{% endschema %}
