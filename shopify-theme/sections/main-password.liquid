<div class="wrap page" style="min-height: 70vh; align-content: center">
  <span class="logo">{{ shop.name | upcase }}</span>
  <h1 class="page-title">{{ 'password.title' | t }}</h1>
  {%- if shop.password_message != blank -%}<p class="page-intro">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'search-form' -%}
    {%- if form.errors -%}<p class="form-error" role="alert">{{ form.errors.messages['form'] }}</p>{%- endif -%}
    <label class="visually-hidden" for="password">{{ 'password.password' | t }}</label>
    <input class="input" type="password" name="password" id="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
    <button class="btn btn-primary" type="submit">{{ 'password.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Page protégée" }
{% endschema %}
