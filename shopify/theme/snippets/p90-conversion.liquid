{%- comment -%}
  PILOTA90 — Blocs de conversion « above the fold »
  ------------------------------------------------
  Répond aux 3 questions que le visiteur se pose en 8 secondes :
    1. « Ce produit est-il pour moi ? »   -> titre produit + puces « pour qui »  (part: 'sous_titre')
    2. « Comprend-il mon problème ? »     -> métachamp p90.sous_titre            (part: 'sous_titre')
    3. « Pourquoi acheter maintenant ? »  -> métachamps p90.urgence / p90.bonus  (part: 'urgence')

  Usage dans un bloc « Liquid personnalisé » de la section produit :
    {% render 'p90-conversion', part: 'sous_titre' %}   -> à placer sous le titre
    {% render 'p90-conversion', part: 'sous_prix' %}    -> à placer sous le prix
    {% render 'p90-conversion', part: 'urgence' %}      -> à placer juste avant le bouton d'achat
    {% render 'p90-conversion', part: 'paiement' %}     -> à placer sous le bouton d'achat

  Chaque bloc reste invisible tant que son métachamp n'est pas rempli : aucun
  risque d'encadré vide sur un produit non renseigné. Les métachamps s'éditent
  dans Shopify > Produits > (un produit) > section « Métachamps ».
{%- endcomment -%}

{{ 'p90-conversion.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign p90_sub   = product.metafields.p90.sous_titre.value
  assign p90_who   = product.metafields.p90.pour_qui.value
  assign p90_urg   = product.metafields.p90.urgence.value
  assign p90_bonus = product.metafields.p90.bonus.value
  assign p90_proof = product.metafields.p90.preuve.value
  assign p90_benef = product.metafields.p90.benefices.value
-%}

{%- case part -%}

  {%- when 'sous_titre' -%}
    {%- if p90_sub != blank or p90_who != blank -%}
      <div class="p90-c">
        {%- if p90_sub != blank -%}
          <p class="p90-sub">{{ p90_sub | escape | newline_to_br }}</p>
        {%- endif -%}
        {%- if p90_who != blank -%}
          <ul class="p90-who">
            {%- assign p90_chips = p90_who | split: '·' -%}
            {%- for chip in p90_chips -%}
              {%- assign chip_t = chip | strip -%}
              {%- if chip_t != blank -%}<li>{{ chip_t | escape }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}

  {%- when 'sous_prix' -%}
    {%- if p90_benef != blank or p90_proof != blank -%}
      <div class="p90-c">
        {%- if p90_benef != blank -%}
          <ul class="p90-bul">
            {%- for b in p90_benef -%}
              {%- assign b_t = b | strip -%}
              {%- if b_t != blank -%}
                <li>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#C9962B" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 6 9 17l-5-5"/></svg>
                  <span>{{ b_t | escape }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if p90_proof != blank -%}
          <p class="p90-proof">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#10284a" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>{{ p90_proof | escape }}</span>
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

  {%- when 'urgence' -%}
    {%- if p90_urg != blank or p90_bonus != blank -%}
      <div class="p90-c">
        {%- if p90_urg != blank -%}
          <div class="p90-urg">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#C9962B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            <p>{{ p90_urg | escape }}</p>
          </div>
        {%- endif -%}
        {%- if p90_bonus != blank -%}
          <div class="p90-bonus">
            <b>Bonus inclus</b>
            <p>{{ p90_bonus | escape | newline_to_br }}</p>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  {%- when 'paiement' -%}
    {%- if shop.enabled_payment_types.size > 0 -%}
      <div class="p90-c">
        <div class="p90-pay">
          <span class="p90-pay__label">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10284a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Paiement 100 % sécurisé
          </span>
          <div class="p90-pay__icons" aria-label="Moyens de paiement acceptés">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'p90-pay__icon' }}
            {%- endfor -%}
          </div>
          <p class="p90-pay__note">Paiement traité par Shopify. Vos coordonnées bancaires ne nous sont jamais transmises.</p>
        </div>
      </div>
    {%- endif -%}

{%- endcase -%}
