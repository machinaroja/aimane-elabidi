---
import type { Category } from '../data/categories';

interface Props {
  name: Category['emblem'];
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
  {
    name === 'rings' && (
      <>
        <circle cx="50" cy="50" r="38" />
        <circle cx="56" cy="50" r="26" />
        <circle cx="62" cy="50" r="14" />
        <circle cx="66" cy="50" r="3" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'steps' && (
      <>
        <polyline points="12,86 12,70 32,70 32,52 52,52 52,34 72,34 72,16 88,16" />
        <line x1="12" y1="86" x2="88" y2="86" />
        <circle cx="80" cy="16" r="3" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'coin' && (
      <>
        <circle cx="50" cy="44" r="32" />
        <circle cx="50" cy="44" r="22" />
        <path d="M18 62 v12 a32 10 0 0 0 64 0 v-12" />
        <path d="M18 70 a32 10 0 0 0 64 0" />
      </>
    )
  }
  {
    name === 'column' && (
      <>
        <polygon points="50,10 88,30 12,30" />
        <line x1="16" y1="36" x2="84" y2="36" />
        <line x1="26" y1="42" x2="26" y2="80" />
        <line x1="42" y1="42" x2="42" y2="80" />
        <line x1="58" y1="42" x2="58" y2="80" />
        <line x1="74" y1="42" x2="74" y2="80" />
        <line x1="12" y1="86" x2="88" y2="86" />
      </>
    )
  }
</svg>
