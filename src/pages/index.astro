---
import Base from '../layouts/Base.astro';
import BookCover from '../components/BookCover.astro';
import Emblem from '../components/Emblem.astro';
import AddToCart from '../components/AddToCart.astro';
import { SITE } from '../config/site';
import { books, booksByCategory, latestBooks, formatPrice } from '../data/books';
import { categories, categoryBySlug } from '../data/categories';

const shelf = books.filter((b) => b.featured).slice(0, 3);
const spotlight = shelf[0];
const spotlightCategory = categoryBySlug(spotlight.category);
const latest = latestBooks(4);
---

<Base
  title="BIBLIODOR — Ebooks en français : psychologie, argent, pouvoir et influence"
  description={SITE.description}
>
  <section class="hero on-dark" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1 id="hero-title">Des livres pour comprendre comment on pense, on gagne et on décide.</h1>
        <p class="lead">
          BIBLIODOR édite des ebooks en français sur la psychologie, l’argent, le pouvoir et l’influence. Des textes
          clairs, structurés et utiles, à lire sur tous vos écrans.
        </p>
        <div class="hero-actions">
          <a class="btn btn-gold" href="/catalogue/">Parcourir le catalogue</a>
          <a class="btn btn-ghost" href="#nouveautes">Voir les nouveautés</a>
        </div>
      </div>

      <div class="shelf" aria-label="Quelques titres du catalogue">
        <ul class="shelf-books">
          {
            shelf.map((book, i) => (
              <li style={`--i:${i}`}>
                <a href={`/ebooks/${book.slug}/`}>
                  <BookCover book={book} size="m" />
                  <span class="visually-hidden">{book.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="shelf-board" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="rayons wrap" aria-labelledby="rayons-title">
    <header class="section-head">
      <h2 id="rayons-title">Les rayons</h2>
      <p>Quatre domaines, choisis parce qu’ils changent concrètement la vie de ceux qui s’y intéressent.</p>
    </header>
    <ol class="toc">
      {
        categories.map((c) => {
          const count = booksByCategory(c.slug).length;
          return (
            <li>
              <a href={`/categories/${c.slug}/`} class="toc-row">
                <Emblem name={c.emblem} class="toc-emblem" />
                <span class="toc-main">
                  <span class="toc-name">{c.name}</span>
                  <span class="toc-summary">{c.summary}</span>
                </span>
                <span class="toc-leader" aria-hidden="true" />
                <span class="toc-count">
                  {count} titre{count > 1 ? 's' : ''}
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>

  <section class="spotlight" aria-labelledby="spotlight-title">
    <div class="wrap spotlight-grid">
      <a href={`/ebooks/${spotlight.slug}/`} class="spotlight-cover" tabindex="-1" aria-hidden="true">
        <BookCover book={spotlight} size="l" />
      </a>
      <div class="spotlight-text">
        <p class="kicker">À lire en ce moment, rayon {spotlightCategory.name.toLowerCase()}</p>
        <h2 id="spotlight-title">
          <a href={`/ebooks/${spotlight.slug}/`}>{spotlight.title}</a>
        </h2>
        <p class="subtitle">{spotlight.subtitle}</p>
        <h3>Ce que vous en retirerez</h3>
        <ul class="takeaways">
          {spotlight.takeaways.map((t) => <li>{t}</li>)}
        </ul>
        <p class="facts">
          {spotlight.pages} pages, formats {spotlight.formats.join(' et ')}
        </p>
        <div class="buy">
          <p class="price">{formatPrice(spotlight.priceCents)}</p>
          <AddToCart slug={spotlight.slug} title={spotlight.title} />
          <a class="text-link" href={`/ebooks/${spotlight.slug}/`}>Lire la présentation</a>
        </div>
      </div>
    </div>
  </section>

  <section class="latest wrap" id="nouveautes" aria-labelledby="latest-title">
    <header class="section-head row">
      <h2 id="latest-title">Nouveautés</h2>
      <a class="text-link" href="/catalogue/?tri=recent">Tout le catalogue</a>
    </header>
    <ul class="book-grid">
      {
        latest.map((book) => (
          <li class="book-item">
            <BookCover book={book} size="s" />
            <h3>
              <a href={`/ebooks/${book.slug}/`} class="stretch">
                {book.title}
              </a>
            </h3>
            <p class="book-meta">{categoryBySlug(book.category).name}</p>
            <p class="price">{formatPrice(book.priceCents)}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="how" aria-labelledby="how-title">
    <div class="wrap how-grid">
      <h2 id="how-title">De la page du livre à votre liseuse</h2>
      <ol class="steps">
        <li>
          <h3>Choisissez</h3>
          <p>Chaque fiche présente le sommaire, ce que vous apprendrez et le nombre de pages. Vous savez ce que vous achetez.</p>
        </li>
        <li>
          <h3>Payez en ligne</h3>
          <p>
            Le paiement est traité par un prestataire spécialisé. BIBLIODOR ne voit ni ne stocke vos coordonnées
            bancaires.
          </p>
        </li>
        <li>
          <h3>Téléchargez</h3>
          <p>
            Dès le paiement confirmé, vos ebooks sont disponibles en EPUB et en PDF, et un lien vous est envoyé par
            e-mail.
          </p>
        </li>
      </ol>
      <p class="how-help">
        Une question avant d’acheter ? <a href="/faq/">Consultez les réponses aux questions fréquentes</a>{' '}
        ou <a href="/contact/">écrivez-nous</a>.
      </p>
    </div>
  </section>

  <section class="house wrap" aria-labelledby="house-title">
    <h2 id="house-title">Une maison d’édition, pas un entrepôt de fichiers</h2>
    <div class="house-text">
      <p class="house-lead">
        Chaque titre BIBLIODOR part d’une question précise que se posent nos lecteurs, et y répond avec méthode : des
        idées sourcées, des exemples concrets, un plan qui se suit.
      </p>
      <p>
        Nous préférons un livre de 150 pages qu’on termine à un pavé qu’on abandonne. Pas de promesses miracles, pas de
        remplissage : un texte relu, mis en page avec soin, qui respecte votre temps.
      </p>
      <a class="text-link" href="/a-propos/">Découvrir la maison</a>
    </div>
  </section>
</Base>

<style>
  /* ——— Ouverture ——— */
  .hero {
    background: var(--forest);
    color: var(--cream);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-xl) 0;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 1.6rem + 2.4vw, 3.75rem);
    font-variation-settings: 'opsz' 72;
    font-weight: 450;
    max-width: 20ch;
  }

  .lead {
    margin-top: var(--space-m);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--sage);
    max-width: 44ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }

  .hero-actions .btn-ghost {
    color: var(--cream);
  }

  .shelf {
    position: relative;
    align-self: end;
  }

  .shelf-books {
    list-style: none;
    margin: 0;
    padding: 0 var(--space-s);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
    align-items: end;
  }

  .shelf-books li {
    animation: settle 0.7s var(--ease) both;
    animation-delay: calc(var(--i) * 90ms + 120ms);
  }

  /* Les livres n'ont pas tous la même taille sur une vraie étagère */
  .shelf-books li:nth-child(1) { width: 90%; justify-self: end; }
  .shelf-books li:nth-child(2) { width: 100%; }
  .shelf-books li:nth-child(3) { width: 94%; }

  .shelf-books a {
    display: block;
    transition: transform 0.25s var(--ease);
  }

  .shelf-books a:hover,
  .shelf-books a:focus-visible {
    transform: translateY(-6px);
  }

  .shelf-board {
    height: 14px;
    background: var(--gold);
    border-top: 3px solid var(--gold-light);
    box-shadow: 0 10px 18px -6px rgb(0 0 0 / 0.45);
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 60rem) {
    .hero-grid {
      grid-template-columns: 1.15fr 1fr;
      column-gap: var(--space-2xl);
      align-items: end;
      padding-top: var(--space-xl);
    }
    .shelf-books {
      padding-inline: 0;
    }
    .hero-text {
      padding-bottom: var(--space-2xl);
    }
    .shelf {
      align-self: end;
    }
  }

  /* ——— Titres de section ——— */
  .section-head {
    display: grid;
    gap: var(--space-2xs);
    margin-bottom: var(--space-l);
  }

  .section-head h2 {
    font-size: var(--step-3);
  }

  .section-head p {
    color: var(--ink-muted);
    max-width: 52ch;
  }

  .section-head.row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
  }

  /* ——— Rayons, présentés comme un sommaire ——— */
  .rayons {
    padding-block: var(--space-2xl);
  }

  .toc {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--forest);
  }

  .toc li {
    border-bottom: 1px solid var(--line);
  }

  .toc-row {
    display: grid;
    grid-template-columns: 2.75rem 1fr auto;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    padding-block: var(--space-m);
    text-decoration: none;
  }

  .toc-emblem {
    width: 2.75rem;
    color: var(--gold);
    transition: transform 0.3s var(--ease);
  }

  .toc-main {
    display: grid;
    gap: var(--space-3xs);
  }

  .toc-name {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-variation-settings: 'opsz' 48;
    line-height: 1.15;
  }

  .toc-summary {
    color: var(--ink-muted);
    max-width: 56ch;
  }

  .toc-leader {
    display: none;
  }

  .toc-count {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    white-space: nowrap;
  }

  .toc-row:hover .toc-name {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .toc-row:hover .toc-emblem {
    transform: rotate(-8deg);
  }

  @media (min-width: 48rem) {
    .toc-row {
      grid-template-columns: 3.5rem minmax(0, auto) 1fr auto;
    }
    .toc-emblem {
      width: 3.5rem;
    }
    .toc-leader {
      display: block;
      align-self: end;
      margin-bottom: 0.6rem;
      min-width: 2rem;
      border-bottom: 2px dotted var(--gold);
    }
  }

  /* ——— Livre à la une ——— */
  .spotlight {
    background: var(--paper);
    border-block: 1px solid var(--line);
    padding-block: var(--space-2xl);
  }

  .spotlight-grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .spotlight-cover {
    width: min(20rem, 72%);
    margin-inline: auto;
  }

  .kicker {
    color: var(--gold-ink);
    font-weight: 600;
  }

  .spotlight h2 {
    font-size: var(--step-3);
    font-variation-settings: 'opsz' 60;
    margin-top: var(--space-2xs);
  }

  .spotlight h2 a {
    text-decoration: none;
  }

  .spotlight h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold);
  }

  .subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--ink-muted);
    margin-top: var(--space-xs);
    max-width: 40ch;
  }

  .spotlight h3 {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 700;
    margin-top: var(--space-l);
  }

  .takeaways {
    margin: var(--space-xs) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-xs);
    max-width: 54ch;
  }

  .takeaways li {
    padding-left: 1.5rem;
    position: relative;
  }

  .takeaways li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.7rem;
    height: 2px;
    background: var(--gold);
  }

  .facts {
    margin-top: var(--space-m);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-m);
  }

  .buy .price {
    font-size: var(--step-2);
  }

  @media (min-width: 52rem) {
    .spotlight-grid {
      grid-template-columns: 2fr 3fr;
      gap: var(--space-2xl);
    }
    .spotlight-cover {
      width: 100%;
      max-width: 22rem;
      justify-self: end;
    }
  }

  /* ——— Nouveautés ——— */
  .latest {
    padding-block: var(--space-2xl);
  }

  .book-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l) var(--space-m);
  }

  @media (min-width: 52rem) {
    .book-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-xl) var(--space-l);
    }
  }

  .book-item {
    position: relative;
    display: grid;
    gap: var(--space-3xs);
    align-content: start;
  }

  .book-item :global(.cover) {
    margin-bottom: var(--space-s);
    transition: transform 0.25s var(--ease);
  }

  .book-item:hover :global(.cover) {
    transform: translateY(-4px);
  }

  .book-item h3 {
    font-size: var(--step-1);
    font-variation-settings: 'opsz' 28;
  }

  .book-item h3 a {
    text-decoration: none;
  }

  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .book-item:hover h3 a {
    text-decoration: underline;
    text-decoration-color: var(--gold);
  }

  .book-meta {
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  /* ——— Parcours d'achat ——— */
  .how {
    background: var(--forest);
    color: var(--cream);
    padding-block: var(--space-2xl);
  }

  .how-grid {
    display: grid;
    gap: var(--space-l);
  }

  .how h2 {
    font-size: var(--step-3);
    max-width: 18ch;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-l);
    counter-reset: step;
  }

  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-3xs) var(--space-s);
    align-content: start;
  }

  .steps li::before {
    content: counter(step);
    grid-row: span 2;
    font-family: var(--font-serif);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--gold-light);
  }

  .steps h3 {
    font-size: var(--step-1);
  }

  .steps p {
    color: var(--sage);
    max-width: 38ch;
  }

  .how-help {
    color: var(--sage);
    border-top: 1px solid var(--line-dark);
    padding-top: var(--space-m);
  }

  .how-help a {
    color: var(--cream);
    text-decoration-color: var(--gold-light);
  }

  .how :focus-visible {
    outline-color: var(--gold-light);
  }

  @media (min-width: 60rem) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ——— La maison ——— */
  .house {
    padding-block: var(--space-2xl);
    display: grid;
    gap: var(--space-l);
  }

  .house h2 {
    font-size: var(--step-3);
    max-width: 16ch;
  }

  .house-text {
    display: grid;
    gap: var(--space-m);
    max-width: var(--measure);
    justify-items: start;
  }

  .house-lead {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.6;
  }

  @media (min-width: 60rem) {
    .house {
      grid-template-columns: 1fr 1.4fr;
      gap: var(--space-2xl);
    }
  }
</style>
